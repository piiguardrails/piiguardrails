          }
        ]
      ]
    },
    "Mask PII with Enterprise Guardrails": {
      "main": [
        [
          {
            "node": "Process Prompt with LLM (Simulated)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Prompt with LLM (Simulated)": {
      "main": [
        [
          {
            "node": "Restore Original PII from Tokens",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
